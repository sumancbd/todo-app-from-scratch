<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script>
      (() => {
        const storageKey = "theme-preference";
        const storedTheme = localStorage.getItem(storageKey);
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        const theme = storedTheme || systemTheme;
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="hero">
      <div class="hero-topbar">
        <p class="eyebrow">Express and EJS Starter</p>
        <button class="theme-toggle" type="button" aria-label="Switch color theme">
          <span class="theme-toggle__label">Dark mode</span>
        </button>
      </div>
      <h1><%= title %></h1>
      <p class="summary">
        World's simplest todo app.
      </p>
      <button class="cta" type="button" data-health-button>Check health</button>
      <p class="health-status" data-health-status aria-live="polite">
        Health status will appear here.
      </p>
    </main>
    <script src="/homepage.js"></script>
  </body>
</html>
